# Homeward runs against a local stand-in of the simulator by default (npm run demo),
# which needs none of these. They matter only with --live (npm run demo:live, npm run flow:live).

# Base URL of a simulator. The shared hackathon instance (https://sim.animahacks.com)
# stopped answering on 13 Sep 2026; a standalone local stand-in is at
# http://127.0.0.1:4680 after `npm run sim:local`.
SIM_ORIGIN=https://sim.animahacks.com
# Team API key for --live runs. Copy it from "Team & API key" in the simulator, or create one
# with `node scripts/quickstart.ts --create-team "My team"`.
SIM_KEY=your-team-key-here

# OpenAI key for the ADK-powered LLM layer (drafting + barrier reading).
# Without it the orchestrator falls back to canned drafts and the UI says so.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
